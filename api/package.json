{
  "name": "hostclaw-api",
  "version": "1.0.0",
  "description": "HostClaw.ai - Automated OpenClaw Cloud Hosting API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node config/migrate.js",
    "test": "jest",
    "lint": "eslint .",
    "render:build": "npm install",
    "render:start": "node server.js",
    "docker:build": "docker build -t hostclaw/api:latest .",
    "docker:push": "docker push hostclaw/api:latest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "openai": "^4.28.0",
    "pg": "^8.11.3",
    "stripe": "^14.9.0",
    "bull": "^4.12.0",
    "axios": "^1.6.2",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "openclaw",
