{
  "root": ".",
  "clean_urls": true,
  "routes": {
    "/api/*": {
      "url": "https://hostclaw-api.onrender.com/api/:splat"
    },
    "/webhooks/*": {
      "url": "https://hostclaw-api.onrender.com/webhooks/:splat"
    },
    "/**": "index.html"
  },
  "headers": {
    "/**": {
      "Cache-Control": "public, max-age=0, must-revalidate"
    },
    "/assets/**": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }
  }
}
